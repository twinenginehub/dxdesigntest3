# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel: Project Settings > Environment Variables.

# Any PostgreSQL connection string (Neon, Vercel Postgres, Supabase). Use the pooled connection string.
DATABASE_URL=

# The single dashboard login password.
DASHBOARD_PASSWORD=

# Random string, 32+ characters, used to sign dashboard sessions and hash network addresses.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local development only: use an embedded Postgres instead of DATABASE_URL.
# LOCAL_DB=pglite
